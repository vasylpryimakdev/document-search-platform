#!/bin/bash
set -euxo pipefail

dnf update -y
dnf install -y docker nginx certbot python3-certbot-nginx tar gzip
systemctl enable --now docker
systemctl enable --now nginx

if ! command -v node >/dev/null 2>&1; then
  curl -fsSL https://rpm.nodesource.com/setup_22.x | bash -
  dnf install -y nodejs
fi

mkdir -p /opt/document-search-platform/apps/api
mkdir -p /opt/document-search-platform/infra

docker volume create document_search_postgres_data
docker volume create document_search_opensearch_data

docker rm -f document-search-postgres || true
docker rm -f document-search-opensearch || true

docker run -d \
  --name document-search-postgres \
  --restart unless-stopped \
  -e POSTGRES_USER=app \
  -e POSTGRES_PASSWORD=password \
  -e POSTGRES_DB=document_search \
  -p 127.0.0.1:5433:5432 \
  -v document_search_postgres_data:/var/lib/postgresql/data \
  postgres:16-alpine

docker run -d \
  --name document-search-opensearch \
  --restart unless-stopped \
  -e discovery.type=single-node \
  -e plugins.security.disabled=true \
  -e OPENSEARCH_JAVA_OPTS="-Xms512m -Xmx512m" \
  -e OPENSEARCH_INITIAL_ADMIN_PASSWORD="R9!vK2#pL8@zQ5xT7nY" \
  -p 127.0.0.1:9200:9200 \
  -p 127.0.0.1:9600:9600 \
  -v document_search_opensearch_data:/usr/share/opensearch/data \
  opensearchproject/opensearch:2.15.0

cat >/etc/systemd/system/document-search-api.service <<'SERVICE'
[Unit]
Description=Document Search Platform API
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/opt/document-search-platform/apps/api
EnvironmentFile=/opt/document-search-platform/apps/api/.env
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
SERVICE

cat >/etc/nginx/conf.d/document-search-api.conf <<'NGINX'
server {
    listen 80;
    server_name _;

    location / {
        proxy_pass http://127.0.0.1:${api_port};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
    }
}
NGINX

nginx -t
systemctl reload nginx
systemctl daemon-reload
systemctl enable document-search-api
